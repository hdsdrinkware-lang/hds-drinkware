# Preview-only Worker configuration template.
# Namespace 22022026 was selected after the 2026-10-19 account inventory
# returned no accessible Worker scripts or existing Rate Limiting bindings.

name = "hds-rfq-upload-limiter-preview"
main = "src/index.js"
compatibility_date = "2026-10-19"
workers_dev = false

# The Rate Limiting API is a Workers binding, not a Pages Functions binding.
[[ratelimits]]
name = "RFQ_UPLOAD_LIMITER"
namespace_id = "22022026"

[ratelimits.simple]
limit = 5
period = 60
